# RTSP
RTSP_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/stream1

# Telegram
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Inference — calibrated for ST-GCN++ LDAM K-fold (best per-run sweep median)
FALL_THRESHOLD=0.45
HIGH_CONFIDENCE_THRESHOLD=0.70
VELOCITY_THRESHOLD=0.5
NOTIFICATION_COOLDOWN_SECONDS=30
FPS_TARGET=15

# Storage
CLIPS_DIR=/app/clips
MODELS_DIR=/app/models
MAX_CLIPS_STORAGE_GB=5

# Server
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# Model paths (relative to MODELS_DIR).
# ST-GCN++ 2-stream production weights live as stgcn_prod_{J,B}.pth.
YOLO_POSE_MODEL=yolo26s-pose.pt
AGE_GENDER_MODEL=age_gender_ver4_best.pt
GLASSES_MODEL=glasses_ver2_best.pt

# Lazy loading
LAZY_LOAD_TRIAGE_MODELS=true

# Glasses model — v2 produces too many false positives. Re-enable when v3 lands.
ENABLE_GLASSES_MODEL=false
